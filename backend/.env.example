NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=lab_crud

JWT_SECRET=randomsecretkey
JWT_EXPIRES_IN=2h

# Admin inicial (opcional): si se define, se crea automaticamente al arrancar 
# el servidor por primera vez contra una base de datos nueva. Si ya existe un 
# usuario con el mismo email, no se crea.
ADMIN_NAME=Andres
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD:Admin123